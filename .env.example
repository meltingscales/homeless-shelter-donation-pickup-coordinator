# Database Configuration
# Set USE_POSTGIS=false to use SQLite for development
USE_POSTGIS=true

# PostgreSQL connection string (only needed if USE_POSTGIS=true)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://shelter_user:shelter_pass@localhost:5432/shelter_pickup

# Google Maps Geocoding API Key
# Get one from: https://developers.google.com/maps/documentation/geocoding/get-api-key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
